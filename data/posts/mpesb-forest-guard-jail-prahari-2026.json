  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000; font-size: 13pt;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong>  <span style=\"color: #000000;\">has released admit card for the posts of Forest Guard and Jail Prahari. This recruitment was released for <strong>1679</strong> posts. </span></span></span><span style=\"color: #000000;\">Applications for the <span style=\"font-size: 13pt;\">MPESB Forest Guard &amp; Jail Prahari</span> Recruitment 2026 were accepted from <span style=\"font-size: 13pt;\"><strong data-start=\"970\" data-end=\"990\">28 February 2026</strong></span>, to <span style=\"font-size: 13pt;\"><strong data-start=\"1023\" data-end=\"1040\">30 April 2026</strong></span>. The written examination is going to be conducted on 04 June 2026. Candidates who had applied this form can download their MPESB Forest Guard &amp; Jail Prahari Admit Card 2026 from the link given below.</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Madhya Pradesh Employees Selection Board (MPESB)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">MPESB Forest Guard &amp; Jail Prahari Admit Card 2026</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>28 February 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>30 April 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <b><strong>30 April 2026</strong></b></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Correction Date : <strong>30 April 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam Date : <strong>04 June 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card : <strong>28 May 2026</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">General :<strong> Rs. 500/-</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">SC, ST, OBC, EWS :<strong> Rs. 250/-</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">EWS, PH (Divyang) :<strong> Rs. 250/-</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Correction Charge :<strong> Rs. 20/-</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Portal Charges : <strong>Rs. 60/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>MPESB Forest Guard &amp; Jail Prahari Notification 2026 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Age Limit As On 01 January 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Minimum Age :&nbsp;<strong>18 Years (For All Candidate)</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Minimum Age : <strong>21 Years (Asst. Jail Superintendent)</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Maximum Age :&nbsp;<strong>33 Years (Forest Guard)</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per MPESB Forest Guard and Jail Prahari Recruitment Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #000000; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>MPESB Forest Guard &amp; Jail Prahari 2026 : Vacancy Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Posts : 1679 Posts</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>No. of Posts</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Jail Superintendent</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">25</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Jail Prahari</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">757</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Vanrakshak</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">728</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Kshetra Rakshak</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">169</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>MPESB Forest Guard &amp; Jail Prahari Recruitment 2026 : Educational Qualification</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates who have Passed <strong>10th grade (High School) or Graduate Passed</strong> from a recognized University in India.</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">All candidates must read the official information completely before applying.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>How To Download MPESB Forest Guard &amp; Jail Prahari Admit Card 2026</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Open on the region wise&nbsp;<strong>Download Admit Card</strong>&nbsp;link from the&nbsp;<strong>Important Links&nbsp;</strong>box placed below.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates will be redirected to a new page.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">In this page, candidates have to fill up the required fields given as following:</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Registration ID/ Roll Number/ Name</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Date of Birth</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Father’s Name (In case of searching by name)</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Captcha code</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">And Click on&nbsp;<strong>Search</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">After submitting the correct details, applicants will be able to download the admit card.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>MPESB Forest Guard &amp; Jail Prahari Recruitment 2026 : Mode of Selection</strong></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Shortlisting of Candidates</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Document Verification</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Medical Examination </span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"newtable2\">\n<table style=\"width: 100%;\">\n<tbody>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><strong>Follow SarkariExam on Instagram</strong></span></td>\n<td class=\"post-social-link\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"3\" data-align=\"center\"><strong></strong></td>\n</tr>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><b>Join Our WhatsApp Channel</b></span></td>\n<td class=\"post-social-link\" style=\"text-align: center;\" colspan=\"3\" data-align=\"center\"><strong><a hr