2\">\n<h2><span style=\"color: #ff00ff;\"><strong>Apply Online</strong></span></h2>\n</td>\n<td style=\"text-align: center; height: 104px;\" colspan=\"3\">\n<h2><strong><a title=\"BSNL JTO Exam\" href=\"https://jrdsu.org/admission/register\" target=\"_blank\" rel=\"noopener\">Click Here</a></strong></h2>\n</td>\n</tr>\n<tr style=\"height: 62px;\">\n<td style=\"text-align: center; width: 47.628%; height: 62px;\" colspan=\"2\">\n<h2><span style=\"color: #ff00ff;\"><strong>Candidate Login</strong></span></h2>\n</td>\n<td style=\"text-align: center; width: 48.4812%; height: 62px;\" colspan=\"3\">\n<h2><a href=\"https://jrdsu.org/admission/login\"><span style=\"color: #0000ff;\"><strong>Click Here</strong></span></a></h2>\n</td>\n</tr>\n<tr style=\"height: 62px;\">\n<td style=\"text-align: center; height: 62px;\" colspan=\"2\">\n<h2><span style=\"color: #ff00ff;\"><strong>Download Short Notice</strong></span></h2>\n</td>\n<td style=\"text-align: center; height: 62px;\" colspan=\"3\">\n<h2><strong></strong></h2>\n</td>\n</tr>\n<tr style=\"height: 62px;\">\n<td style=\"text-align: center; height: 62px; width: 47.628%;\" colspan=\"2\">\n\n</td>\n<td style=\"text-align: center; width: 48.4812%; height: 62px;\" colspan=\"3\">\n\n</td>\n</tr>\n<tr style=\"height: 62px;\">\n<td style=\"width: 47.628%; text-align: center; height: 62px;\" colspan=\"2\">\n<h2><span style=\"color: #ff00ff;\"><strong>Official Website</strong></span></h2>\n</td>\n<td style=\"text-align: center; width: 48.4812%; height: 62px;\" colspan=\"3\">\n<h2><a title=\"JRDSU Official Website\" href=\"https://www.jrdsu.up.gov.in/\" target=\"_blank\" rel=\"noopener\"><b>JRDSU Official Website</b></a></h2>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n<div class=\"gb-container gb-container-6da1cb96\">\n\n<h3 class=\"gb-headline gb-headline-325acb59\"><span class=\"gb-icon\"><svg aria-hidden=\"true\" role=\"img\" height=\"1em\" width=\"1em\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path fill=\"cu