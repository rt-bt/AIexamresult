  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://rpsc.rajasthan.gov.in/news\" target=\"_blank\" rel=\"nofollow\">Rajasthan Public Service Commission (RPSC)</a> <span style=\"color: #000000;\">will release the admit card for the post of 1st Grade Teacher&nbsp; (School Lecturer) PGT Teacher. This recruitment has been issued for 3225 posts. Online applying process for Rajasthan RPSC School Lecturer Recruitment 205 were accepted from 14 August 2025 to 12 September 2025. The Examination is Going to conducted on 31 May to 11 June 2026, Candidates must check the complete details for Rajasthan RPSC School Lecturer PGT Teacher Admit Card 2026 which has given below.&nbsp;</span></span></span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Rajasthan Public Service Commission (RPSC)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">RPSC School Lecturer PGT Teacher Admit Card 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">RPSC School Lecturer Advt No 06/2025-26</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Notification Date : <strong>17 July 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>14 August 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <span style=\"color: #ff0000;\"><strong>12 September 2025</strong></span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>12 September 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt; background-color: #ffff00;\">Exam Date : <strong>31 May to 11 June 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam City Details : <strong>24 May 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card : <strong>28 May 2026</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">General / Other State : <strong>Rs.</strong> <b>600/-</b></span></li>\n<li><span style=\"font-size: 12pt;\">OBC / BC : <strong>Rs.</strong> <b>400/-</b></span></li>\n<li><span style=\"font-size: 12pt;\">SC / ST : <strong>Rs.</strong> <b>400/-</b></span></li>\n<li><span style=\"font-size: 12pt;\">Correction Charge : <strong>Rs.</strong> <b>500/-</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>RPSC School Lecturer PGT