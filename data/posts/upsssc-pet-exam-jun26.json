  "fullContentHtml": "<div class=\"gb-container gb-container-b39c368c\">\n\n<div>\n<div>\n<center>\n<!-- Internal_head_07-11-2024 -->\n\n</center>\n</div>\n</div>\n\n\n<div class=\"gb-headline gb-headline-3a6be1b8 gb-headline-text\"><table style=\"border-collapse: collapse;width: 100%;height: 225px\">\n<tbody>\n<tr style=\"height: 36px\">\n<td style=\"width: 22.6212%;text-align: center;height: 36px;border-style: none\"><span style=\"color: #ff0000\"><strong>Name Of Post :</strong></span></td>\n<td style=\"width: 77.3788%;height: 36px;border-style: none\">\n<h1><strong>UP </strong><strong>UPSSSC Preliminary Examination Test PET 2026 Apply Online Form 2026 Extended</strong></h1>\n</td>\n</tr>\n<tr style=\"height: 22px\">\n<td style=\"width: 22.6212%;text-align: center;height: 35px;border-style: none\"><span style=\"color: #ff0000\"><strong>Post Date / Update :</strong></span></td>\n<td style=\"width: 77.3788%;height: 35px;border-style: none\">01 September 2026 | 05:05 PM</td>\n</tr>\n<tr style=\"height: 154px\">\n<td style=\"width: 22.6212%;text-align: center;height: 154px;border-style: none\"><span style=\"color: #ff0000\"><strong>Short Information </strong></span></td>\n<td style=\"width: 77.3788%;height: 154px;border-style: none;vertical-align: middle\">\n<p style=\"text-align: left\">Uttar Pradesh Subordinate Service Selection Commission (UPSSSC)&nbsp; has released Soon Preliminary Examination Test PET Examination Recruitment Notification. Those candidates who are interested in this UPSSSC Preliminary Examination Test PET 2026 can Apply Online <strong>03/08/2026 to 07/09/2026</strong>. Read the notification for UP Preliminary Examination Test PET eligibility, Exam information, Vacancy procedure and all other information.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n<center>\n<!-- SR26042026_Square -->\n\n</center>\n\n\n\n\n\n<div class=\"social-grid\">\n\n<div class=\"social-box telegram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" sr