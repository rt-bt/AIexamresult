  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://upsc.gov.in/\" target=\"_blank\" rel=\"noopener nofollow\">Union Public Service Commission (UPSC)</a></span> has released the reserve list for the post of CAPF Assistant Commandant (CPF AC). This recruitment was released for 506 posts. Applications for the UPSC CPF AC Recruitment 2024 were accepted from April 26, 2024, to May 14, 2024. The Interview examination is going to be conducted on 04 April 2025. Candidates who appeared for this examination can download their reserve list from the link given below.</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Union Public Service Commission (UPSC)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">UPSC CPF AC Reserve List 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">UPSC CPF Advt NO. : 09/2024</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>26 April 2024</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>14 May 2024</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>14 May 2024</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Correction Date :&nbsp;<strong>15-21 May 2024</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Exam Date :<strong> 04 August 2024</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Admit Card Available :<b> 26 July 2024</b></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Result Available :<b> 24 September 2024</b></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Interview Schedule Available : <b>04 April 2025</b></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Phase-II Interview Schedule Released : <strong>09 May 2025</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Final Result : <strong>09 May 2025</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Reserve List : <strong>12 June 2026</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">General, EWS, OBC <strong>: Rs. 200/-</strong></span></li>\n<li><span style=\"font-size: 12pt;\">SC, ST <strong>: 0/-</strong></span></li>\n<li><span style=\"font-size: 12pt;\">All Category Female :&nbsp;<b>0/- (Exempted)</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\