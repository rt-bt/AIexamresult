dth=\"620\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Defence Research &amp; Development Organisation (DRDO)</b></span></h2>\n<h2 align=\"center\"><b><span style=\"color: #008000;\">DRDO CEPTAM 11 Recruitment 2025</span></b></h2>\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>DRDO Advt No. CEPTAM 11 : Short Details of Notification</b></span></h2>\n<h2 align=\"center\"><span style=\"color: #ff0000;\"><b></b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"8\" valign=\"top\" width=\"347\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Important Dates</b></span><b></b></h2>\n<ul>\n<li>Application Begin :<b> 11/12/2025</b></li>\n<li>Last Date for Apply Online :<span style=\"color: #ff0000;\"><b>11/01/2026</b></span></li>\n<li>Last Date Pay Exam Fee :<b>13/01/2026</b></li>\n<li>Tier I Exam Date :<strong>23/03/2026</strong></li>\n<li>Exam City Available : <b>11/03/2026<br>\n</b></li>\n<li>Admit Card Available : <b>20/03/2026<br>\n</b></li>\n<li>Answer Key Available : <b>After Exam<br>\n</b></li>\n<li>Tier I Result Available : <b>25/05/2026<br>\n</b></li>\n<li>Tier II Exam Date :<strong>15/06/2026</strong></li>\n<li>Tier II Admi Card Available : <strong>12/06/2026</strong></li>\n<li>Tier II Exam Answer Key Available : <strong>18/06/2026</strong></li>\n</ul>\n</td>\n<td colspan=\"6\" valign=\"top\" width=\"273\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Application Fee</b></span><b></b></h2>\n<ul>\n<li><strong>STA B:</strong></li>\n<li>General / OBC / EWS : <b>750/-</b></li>\n<li>SC / ST / PH / Female : <b>500/-</b></li>\n<li>Refund Fees : <strong>500/-</strong> (After CBT Appear)</li>\n<li><strong>Tech A:</strong></li>\n<li>General / OBC / EWS : <b>600/-</b></li>\n<li>SC / ST / PH / Female : <b>500/-</b></li>\n<li>Refund Fees : <strong>500/-</strong> (After CBT Appear)</li>\n<li>Pay the Examination Fee Through Cast at E Challan or Debit Card, Credit Card, Net Banking<b> </b></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>DRDO CEPTAM 11 Notification 2025 : <span style=\"color: #ff00ff;\">Age Limit as on </span></b><span style=\"color: #ff00ff;\"><b>01/01/2026</b></span></span></h2>\n<ul>\n<li>Minimum Age :<strong> 18 Years</strong></li>\n<li>Maximum Age : <strong>28 Years</strong></li>\n<li>Age Relaxation Extra as per DRDO CEPTAM 11 Recruitment Rules.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>DRDO CEPTAM 11 Recruitment 2025: <span style=\"color: #008000;\">Vacancy Details </span></b><span style=\"color: #008000;\"><b>Total : 764 Post</b></span></span></h2>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"125\">\n<p align=\"center\"><b>Post Name</b></p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"159\">\n<p align=\"center\"><b>Total Post</b></p>\n</td>\n<td colspan=\"8\" valign=\"top\" width=\"336\">\n<p align=\"center\"><b>DRDO CEPTAM 11 Eligibility</b></p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"125\">\n<p align=\"center\">Senior Technical Assistant STA – B</p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"159\">\n<p align=\"center\">561</p>\n</td>\n<td colspan=\"8\" valign=\"top\" width=\"336\">\n<ul>\n<li>Bachelor Degree in Science B.SC / Diploma in Related Trade / Branch.</li>\n<li>More Eligibility Details Read the Notification.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"125\">\n<p align=\"center\">Technician – A (Tech A)</p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"159\">\n<p align=\"center\">203</p>\n</td>\n<td colspan=\"8\" valign=\"top\" width=\"336\">\n<ul>\n<li>10th with ITI Certificate in Related Trade.</li>\n<li>More Eligibility Details Read the Notification.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\"><center><br>\n<!-- 300 x 250 mar 23 --><br>\n<br>\n</center><p></p>\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>How to Fill DRDO CEPTAM 11 Recruitment Online Form 2025</b></span></h2>\n<ul>\n<li>DRDO CEPTAM 11 Recruitment for Various Post Candidate Can Apply Between <strong>11/12/2025 to 11/01/2026</strong></li>\n<li>Candidate Read the Notification Before Apply the Recruitment Application Form in DRDO CEPTAM 11 Recruitment 2025.</li>\n<li>Kindly Check and Collect the All Document – Eligibility, ID Proof, Address Details, Basic Details.</li>\n<li>Kindly Ready Scan Document Related to Recruitment Form – Photo, Sign, ID Proof, Etc.</li>\n<li>Before Submit the Application Form Must Check the Preview and All Column Carefully.</li>\n<li>If Candidate Required to Paying the Application Fee Must Submit. If You have Not the Required Application Fees Your Form is Not Completed.</li>\n<li>Take A Print Out of Final Submitted Form.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Interested Candidates Can Read the Full DRDO CEPTAM 11 Exam 2025 Notification Before Apply Online</b></span></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"7\" valign=\"top\" width=\"328\">\n\n</td>\n<td colspan=\"7\" valign=\"top\" width=\"292\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"14\" valign=\"top\" width=\"620\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Some Useful Important Links</b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"7\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Tier II Answer Key</b></span></h2>\n</td>\n<td colspan=\"7\">\n<h2 align=\"center\"><a title=\"Download Tier II Exam Answer Key\" href=\"https://cdn.digialm.com/EForms/configuredHtml/1258/96576/login.html\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"7\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Tier II Admit Card</b></span></h2>\n</td>\n<t