p\" width=\"111\">\n<p align=\"center\">Prohibition Constable</p>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"132\">\n<p align=\"center\">1603</p>\n</td>\n<td colspan=\"12\" valign=\"top\" width=\"398\">\n<ul>\n<li>10+2 Inter Exam Passed from Any Recognized Board in India.</li>\n<li>More Eligibility Details Read the Notification</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p align=\"center\">Jail Warden</p>\n</td>\n<td colspan=\"4\">\n<p align=\"center\">2417</p>\n</td>\n<td colspan=\"12\">\n<ul>\n<li>10+2 Inter Exam Passed from Any Recognized Board in India.</li>\n<li>More Eligibility Details Read the Notification</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<p align=\"center\">Mobile Squad Contable</p>\n</td>\n<td colspan=\"4\">\n<p align=\"center\">108</p>\n</td>\n<td colspan=\"12\">\n<ul>\n<li>10+2 Inter Exam Passed from Any Recognized Board in India.</li>\n<li>More Eligibility Details Read the Notification</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"18\" valign=\"top\" width=\"641\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b><b><b>Bihar Police </b></b>Post of Prohibition Constable, Jail Warder &amp; Mobile Squad Constable. (Advt. No. 03/2025) Recruitment : <span style=\"color: #ff00ff;\">Physical Eligibility</span></b></span></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" valign=\"top\" width=\"182\">\n<p align=\"center\"><b>Category</b></p>\n</td>\n<td colspan=\"9\" valign=\"top\" width=\"221\">\n<p align=\"center\"><b>Male</b></p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"237\">\n<p align=\"center\"><b>Female</b></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" valign=\"top\" width=\"182\">\n<p align=\"center\"><b>Height</b></p>\n</td>\n<td style=\"text-align: center;\" colspan=\"9\" valign=\"top\" width=\"221\">165 CMS</td>\n<td colspan=\"5\" valign=\"top\" width=\"237\">\n<p align=\"center\">155 CMS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" valign=\"top\" width=\"182\">\n<p align=\"center\"><b>Chest</b></p>\n</td>\n<td colspan=\"9\" valign=\"top\" width=\"221\">\n<p align=\"center\">81-86 CMS</p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"237\">\n<p align=\"center\">Not Available</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" valign=\"top\" width=\"182\">\n<p align=\"center\"><b>Running </b></p>\n</td>\n<td colspan=\"9\" valign=\"top\" width=\"221\">\n<p align=\"center\">1.6 Km in 7 Minutes</p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"237\">\n<p align=\"center\">1 Km in 7 Minutes</p>\n</td>\n</tr>\n<tr>\n<td style=\"text-align: center;\" colspan=\"4\"><strong>High Jump</strong></td>\n<td colspan=\"9\">\n<p align=\"center\">3 Feet 6 Inch</p>\n</td>\n<td colspan=\"5\">\n<p align=\"center\">2 Feet 6 Inch</p>\n</td>\n</tr>\n<tr>\n<td style=\"text-align: center;\" colspan=\"4\"><strong>Long Jump </strong></td>\n<td colspan=\"9\">\n<p align=\"center\">10 Feet</p>\n</td>\n<td colspan=\"5\">\n<p align=\"center\">7 Feet</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"4\" valign=\"top\" width=\"182\">\n<p align=\"center\"><b>Gola Fek</b></p>\n</td>\n<td colspan=\"9\" valign=\"top\" width=\"221\">\n<p align=\"center\">16 Pond Gola Through 14 Feet</p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"237\">\n<p align=\"center\">12 Pond Gola Through 08 Feet</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"18\" valign=\"top\" width=\"641\"><center><br>\n<!-- 300 x 250 mar 23 --><br>\n<br>\n</center><p></p>\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>How to Fill : Bihar Police Prohibition&nbsp; Constables Operator&nbsp; Online Form 2025</b></span></h2>\n<ul>\n<li>Central Selection Board of Prohibition Constables (Operator) in Bihar Police (Advt. No. 03/2025) . Candidate Can Apply Between <b>06/10/2025 to 05/11/2025</b></li>\n<li>Candidate Read the Notification Before Apply the Recruitment Application Form in Bihar Police CSBC Latest 03/2025 Recruitment Online Form 2025.</li>\n<li>Kindly Check and Collect the All Document – Eligibility, ID Proof, Address Details, Basic Details.</li>\n<li>Kindly Ready Scan Document Related to Recruitment Form – Photo, Sign, ID Proof, Etc.</li>\n<li>Before Submit the Application Form Must Check the Preview and All Column Carefully.</li>\n<li>If Candidate Required to Paying the Application Fee Must Submit. If You have Not the Required Application Fees Your Form is Not Completed.</li>\n<li>Take A Print Out of Final Submitted Form.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"18\" valign=\"top\" width=\"641\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Interested Candidates Can Read the Full Notification Before Apply Online.</b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"18\" valign=\"top\" width=\"641\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"8\" valign=\"top\" width=\"316\">\n\n</td>\n<td colspan=\"10\" valign=\"top\" width=\"325\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"18\" valign=\"top\" width=\"641\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Some Useful Important Links</b></span><b> </b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"11\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Check Exam City / Download Admit Card</b></span></h2>\n</td>\n<td colspan=\"7\">\n<h2 align=\"center\"><a title=\"CSBC Bihar Police Admit Card\" href=\"https://apply-csbc.com/csbc_032025_we_admitcards/applicationIndex\" target=\"_blank\" rel=\"noopener\"><span style=\"color: #008000;\"><b>Click Here</b></span></a></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"11\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Exam Notice</b></span></h2>\n</td>\n<td colspan=\"7\">\n<h2 align=\"center\"></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"11\" valign=\"top\" width=\"320\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Apply Online</b></span><b></b></h2>\n</td>\n<td colspan=\"7\" valign=\"top\" width=\"321\">\n<h2 align=\"center\"><a title=\"CSBC Constable Operator Form 2026\" href=\"https://apply-csbc.com/csbc_3_25_mv1/applicationIndex\" target=\"_blank\" rel=\"noopener\"><b>Click Her