  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :&nbsp;</strong><a style=\"color: #ff0000;\" href=\"https://www.sarkariexam.com/bhu-chs-set-2026/\" target=\"_blank\" rel=\"noopener\">Banaras Hindu University (BHU Varanasi)</a></span>&nbsp;<span style=\"font-size: inherit;\">has released the result for the </span><span style=\"font-size: inherit;\">LKG, Nursery, Class 1st, Class 6th and Class 9th, Class 11th along with the School Entrance Test SET 2026</span><span style=\"font-size: inherit;\">.&nbsp;</span><span style=\"font-size: inherit;\">Applications for the BHU CHS SET Online Form 2026 were accepted from 20 February 2026, to 20 March 2026. The entrance examination was held on 22-26 April 2026. Candidates&nbsp;who appeared for this examination can download their BHU CHS SET Admit Card 2026 from the link given below.</span></span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Banaras Hindu University (BHU Varanasi) </span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">BHU CHS SET Admission Result 2026</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"background-color: #ffcc00; color: #000000; font-size: 12pt;\"><strong><span style=\"color: #000000;\">For Class LKG to 6th Admission&nbsp;</span></strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>20 February 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>20 March 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>20 March 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">For Online Correction :<b> 23-27 March 2026</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Date of E-Lottery &amp; Display of Main/Waiting List/Notice&nbsp;:&nbsp;<b>12 April 2026</b></span></li>\n<li><span style=\"background-color: #ffcc00; color: #000000; font-size: 12pt;\"><strong>For Class 9th to 11th Admission&nbsp;</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>20 February 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>20 March 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>20 March 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">For Online Correction :<b> 23 March 2026</b></span></li>\n<li><span style=\"background-color: #ffff00; font-size: 12pt;\"><strong><span style=\"color: #000000; background-color: #ffff00;\">Exam Date :&nbsp;22-26 April 2026</span></strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card Released :&nbsp;<b>11 April 2026</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Answer Key Released :&nbsp;<b>04 May 2026</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Answer Key Objection :&nbsp;<b>04-07 May 2026</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Final Answer Key Released :&nbsp;<b>14 May 2026</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Result Declared : <b>12 June 2026</b></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"background-color: #ffcc00; color: #000000; font-size: 12pt;\"><strong><span style=\"color: #000000;\">For Class LKG to 6th Admission&nbsp;</span></strong></span></li>\n<li><span style=\"font-size: 12pt;\">General, EWS, OBC <strong>: Rs. 750/-</strong></span></li>\n<li><span style=\"font-size: 12pt;\">SC, ST <strong>: Rs. 500/-</strong></span></li>\n<li><span style=\"background-color: #ffcc00; color: #000000; font-size: 12pt;\"><strong>For Class 9th to 11th Admission&nbsp;</strong></span></li>\n<li><span style=\"font-size: 12pt;\">General, EWS, OBC <strong>: Rs. 800/-</strong></span></li>\n<li><span style=\"font-size: 12pt;\">SC, ST <strong>: Rs. 550/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>BHU CHS SET Notification 2026 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\"><strong><span style=\"color: #000000;\">Age Limit As On 31 March 2026</span></strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">LKG : <strong>04 to 05 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Nursery : <strong>05 to 06 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Class 1st : <strong>06 to 08 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Class 6 (VI) : <strong>10 to 12 Years</strong> </span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Class 9 (IX) : <strong>13 to 15 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Class 11 (XI) : <strong>Maximum 18 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per BHU CHS SET Online Form Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #000000; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>BHU CHS SET 2026 : Admission Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Seats : 551 Seats</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 42.6356%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>School Name</strong></span></td>\n<td style=\"width: 28.9558%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Class</strong></span></td>\n<td style=\"width: 28.4085%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>No. of Seats</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 42.6356%; text-align: center;\"><span style=\"font-size: 12pt;\">CHS Girls Kamachha Varanasi</span></td>\n<td style=\"width: 28.9558%; text-align: center;\"><span style=\"font-size: 12pt;\">LKG</span></td>\n<td style=\"width: 28.4085%; text-align: center;\"><span style=\"font-size: 12pt;\">120 Seats</span></td>\n</tr>\n<tr>\n<td style=\"width: 42.6356%; text-align: center;\"><span style=\"font-size: 12pt;\">CHS RGSC Barkachha Mirzapur</span></td>\n<td style=\"width: 28.9558%; text-align: center;\"><span style=\"font-size: 12pt;