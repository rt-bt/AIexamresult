  "fullContentHtml": "<div class=\"gb-container gb-container-b39c368c\">\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%; height: 225px;\">\n<tbody>\n<tr style=\"height: 36px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 36px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Name Of Post :</strong></span></td>\n<td style=\"width: 77.3788%; height: 36px; border-style: none;\">\n<h1><strong>UPSC Combined Defence Service CDS II Recruitment 2026 Apply Online For 451 Post </strong></h1>\n</td>\n</tr>\n<tr style=\"height: 22px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 35px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Post Date / Update :</strong></span></td>\n<td style=\"width: 77.3788%; height: 35px; border-style: none;\">09 June 2026</td>\n</tr>\n<tr style=\"height: 154px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 154px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Short Information </strong></span></td>\n<td style=\"width: 77.3788%; height: 154px; border-style: none; vertical-align: middle;\">\n<p style=\"text-align: left;\">Union Public Service Commission (UPSC) has released Combined Defence Services Exam Second Examination 2026 Notification. Those candidates who are Interested in this UPSC CDS II Vacancy 2026 can Apply Online from 20/05/2026 to 11/06/2026. Read the notification for recruitment eligibility, post information, selection procedure, pay scale and all other information.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n\n\n<div class=\"social-grid\">\n\n<div class=\"social-box telegram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%200%200'%3E%3C/svg%3E\" data-lazy-src=\"https://cdn-icons-png.flaticon.com/512/2111/2111646.png\"><noscript><img decoding=\"async\" src=\"https://cd