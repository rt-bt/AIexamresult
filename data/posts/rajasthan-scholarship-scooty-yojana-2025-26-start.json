  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\" style=\"text-align: justify;\"><span style=\"color: #000000;\"><b><strong>Rajasthan Scholarship Short Details :</strong></b> has invited online applications for&nbsp;<strong>various</strong>&nbsp;<strong data-start=\"157\" data-end=\"191\">scholarship and scooty schemes</strong>&nbsp;for the financial year&nbsp;<strong data-start=\"215\" data-end=\"226\">2025–26</strong>. According to the official notification issued by the department, interested students can apply online from&nbsp;<strong data-start=\"335\" data-end=\"375\">23 September 2025 to 31 October 2025</strong>. Under these schemes, students of the state will be provided&nbsp;<strong data-start=\"440\" data-end=\"511\">scholarships, scooties, incentive amounts, and financial assistance</strong>&nbsp;for higher education. This initiative has been undertaken especially to connect&nbsp;<strong data-start=\"592\" data-end=\"634\">rural and economically weaker students</strong>&nbsp;with the mainstream of education. Candidates must check the complete details for the&nbsp;<strong>Rajasthan Scholarship &amp; Scooty Yojana 2025-26&nbsp;</strong>link provided below.</span></div>\n<div></div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Department of College Education, Jaipur (Rajasthan)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">Rajasthan Scholarship &amp; Scooty Yojana 2025-26</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Rajasthan Scholarship Scheme 2025-26 : Short Details of Notification</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start :<strong> 23 September 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Registration Last Date : <strong>31 October 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date For Form Complete : <strong>31 October 2025</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee </b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">No Application Fees For Any Candidates&nbsp;&nbsp;</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Rajasthan Scholarship Online Form 2025 : Age Limit</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Not Specified</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Rajasthan Scholarship 2025 : Documents Required</b></span></h3>\n<ul>\n<li><strong><span style=\"color: #000000; font-size: 12pt;\">Candidates have to attach the following documents along with the Hard copy of the Online Application Form:</span></strong></li>\n<li>Aadhaar Card</li>\n<li>Domicile Certificate</li>\n<li>Caste Certificate (for SC/ST/OBC/EBC, etc.)</li>\n<li>Marksheet of the Previous Examination</li>\n<li>Copy of Bank Passbook (showing account number and IFSC code clearly)</li>\n<li>Income Certificate (for Economically Backward Class/other schemes)</li>\n<li>Widow/Divorced Woman Certificate (if applicable)</li>\n<li>Study Certificate issued by the College/Institution</li>\n<li><span style=\"color: #000000; font-size: 12pt;\"><strong>For Renewal Candidates –</strong> Kindly Use Last Year Registration Number to Login to Renewal Section and Enter the Fresh Details</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Form Details For Rajasthan Scholarship &amp; Scooty Yojana 2025</strong></span></h3>\n</td>\n</tr>\n<tr>\n<td style=\"text-align: center; width: 34.5864%;\"><span style=\"color: #008000; font-size: 12pt;\"><strong>Scheme Name</strong></span></td>\n<td style=\"text-align: center; width: 64.4677%;\"><span style=\"color: #008000; font-size: 12pt;\"><strong>About Scheme</strong></span></td>\n</tr>\n<tr>\n<td style=\"text-align: center; width: 34.5864%;\">Chief Minister Higher Education Scholarship Scheme</td>\n<td style=\"text-align: center; width: 64.4677%;\" rowspan=\"2\">\n<ul>\n<li>The&nbsp;<strong data-start=\"51\" data-end=\"92\">Rajasthan Scholarship &amp; Scooty Scheme</strong>&nbsp;program started by the Government of Rajasthan. It provides support to bright students belonging to&nbsp;<strong data-start=\"198\" data-end=\"289\">SC, ST, OBC, SBC, EBC, minority communities, and denotified/nomadic/semi-nomadic tribes</strong>.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"text-align: center; width: 34.5864%;\">Widow/Divorced Women Chief Minister (B.Ed.) Support Scheme</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Eligibility Criteria For Rajasthan Scholarship &amp; Scooty Yojana 2025</strong></span></h3>\n</td>\n</tr>\n<tr>\n<td style=\"text-align: center; width: 34.5864%;\" colspan=\"2\">\n<ul>\n<li style=\"text-align: left;\" data-start=\"135\" data-end=\"228\">For girl students of&nbsp;<strong>all categories</strong>&nbsp;who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Higher Education Department).</li>\n<li style=\"text-align: left;\" data-start=\"232\" data-end=\"354\">For girl students of&nbsp;<strong>Scheduled Caste (SC) category</strong>&nbsp;who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Social Justice and Empowerment Department).</li>\n<li style=\"text-align: left;\" data-start=\"358\" data-end=\"497\">For girl students of&nbsp;<strong>Economically Backward Class (EBC)</strong>&nbsp;of the General Category who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Secondary Education Department).</li>\n<li style=\"text-align: left;\" data-start=\"501\" data-end=\"608\">For girl students belonging to&nbsp;<strong>Minority Community</strong>&nbsp;who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Minority Affairs Department).</li>\n<li style=\"text-align: left;\" data-start=\"612\" data-end=\"720\">For girl students of&nbsp;<strong>Scheduled Tribe (ST)</strong>&nbsp;category who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Higher Education Department).</li>\n<li style=\"text-align: left;\" data-start=\"724\" data-end=\"832\">For girl students of&nbsp;<strong>Scheduled Tribe (ST)</strong>&nbsp;category who have passed&nbsp;<strong>class 10th</strong>&nbsp;(Higher Education Department).</li>\n<li style=\"text-align: left;\" data-start=\"836\" data-end=\"970\">For girl students of&nbsp;<strong>Widowed, Divorced, and Abandoned category</strong>&nbsp;who have passed&nbsp;<strong>class 12th</strong>&nbsp;(Social Justice and Empowerment Department).</li>\n<li style=\"text-align: left;\" data-start=\"195\" data-end=\"294\"><strong data-start=\"195\" data-end=\"212\">RBSE students</strong>&nbsp;need at least&nbsp;<strong data-start=\"227\" data-end=\"240\">65% marks</strong>, and&nbsp;<strong data-start=\"246\" data-end=\"263\">CBSE students</strong>&nbsp;need at least&nbsp;<strong data-start=\"278\" data-end=\"291\">75% marks</strong>.</li>\n<li style=\"text-align: left;\" data-start=\"297\" data-end=\"478\">The scholarship is available only for students who take admission as&nbsp;<strong data-start=\"366\" data-end=\"386\">regular students</strong>&nbsp;in a recognized&nbsp;<strong data-start=\"403\" data-end=\"428\">undergraduate program</strong>&nbsp;in Rajasthan (including courses like&nbsp;<strong data-start=\"466\" data-end=\"474\">MBBS</strong>).</li>\n<li dir=\"ltr\" style=\"text-align: left;\"><strong>Income Criteria :&nbsp;</strong>The total annual family income of the candidate shall not be more than ₹2,50,000 from all sources.</li>\n<li dir=\"ltr\" style=\"text-align: left;\"><strong>Domicile Requirement :&nbsp;</strong>The candidate must be a permanent resident of Rajasthan and have a valid domicile certificate.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Rajasthan Scholarship &amp; Scooty Yojana 2025 : How To Apply</strong></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates can apply through link provided below they can also apply through official site of the Rajasthan Scholarship &amp; Scooty Yojana before the due date.</span></li>\n<li><span style=\"font-size: 12pt;\"><span style=\"color: #ff0000;\"><strong>Note :</strong></span> <span style=\"color: #000000;\">Those who are already registered themselves last year they need to renew the current form they will consider as old users &amp; renewal candidates.</span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">You can check other <a style=\"color: #000000;\" href=\"https://www.sarkariexam.com/\" target=\"_blank\" rel=\"noopener\">Sarkari Result</a> notification here – <a style=\"color: #000000;\" href=\"https://www.sarkariexam.com/\" target=\"_blank\" rel=\"noopener\">Check Now</a>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" style=\"width: 99.0541%;\" colspan=\"2\" width=\"100%\">\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p>\n</td>\n</tr>\n<tr>\n<td class=\"post-social-link\" style=\"text-align: center; padding: 10px 0px; width: 99.0541%;\" colspan=\"2\" width=\"100%\"><strong><span style=\"color: #008000;\">IF You Satisfied By</span>&nbsp;<a href=\"https://www.sarkariexam.com/\">SarkariExam.com</a> <span style=\"color: #008000;\">(Website) Please Share With More People.</span></strong></td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"newtable2\">\n<table style=\"width: 100%;\">\n<tbody>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><strong>Follow SarkariExam on Instagram</strong></span></td>\n<td class=\"post-social-link\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"3\" data-align=\"center\"><strong></strong></td>\n</tr>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><b>Join Our WhatsApp Channel</b></span></td>\n<td class=\"post-social-link\" style=\"text-align: center;\" colspan=\"3\" data-align=\"center\"><strong><a href=\"https://whatsapp.com/channel/0029VaAbQf01NCrYADMLt00L\" target=\"_blank\" rel=\"noopener nofollow\">Follow Now</a></strong></td>\n</tr>\n<tr>\n<td style=\"text-align: center; padding: 0px;\" colspan=\"7\" width=\"100%\">\n<h3><strong>Important Links</strong></h3>\n</td>\n</tr>\n<tr>\n<td class=\"tcell\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"4\" width=\"56%\">\n<h4><span style=\"color: #800000;\"><b>Apply Online</b></span></h4>\n</td>\n<td class=\"