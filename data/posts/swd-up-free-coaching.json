nature</li>\n<li>Any Other Supporting Documents<b> </b></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"638\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>UP Free Coaching 2023 <span style=\"color: #ff00ff;\">Center Wise Seats Details</span> <span style=\"color: #ff00ff;\">Total Seats : 1050</span></b></span></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\"><b>Uttar Pradesh IAS / PCS Free Coaching Coaching Center Details<br>\n</b></p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\"><b>Total Seats</b></p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Chhatrapati Shahu Ji Maharaj Shodh Avam Prasikshan Sansthan Bhagidari Bhawan, Lucknow</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">250</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Adarsh Purva Prashikshan Kendra Aliganj, Lucknow (Only for Female)</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">150</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">IAS / PSC Coaching Center, Hapur Ghaziabad</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">200</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Sant Ravisas IAS / PSC Coaching Center Varanasi</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">100</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Dr B.R. Ambedkar Coaching, Agra</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">100</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Dr. B.R. Ambedkar Coaching, Aligarh</p>\n</td>\n<td valign=\"top\" width=\"91\">\n<p align=\"center\">100</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"5\" valign=\"top\" width=\"547\">\n<p align=\"center\">Praya