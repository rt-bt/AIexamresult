  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://www.psc.cg.gov.in/\" target=\"_blank\" rel=\"noopener nofollow\">Chhattisgarh Public Service Commission (CGPSC)</a>&nbsp;</span>has released the Result for the CGPSC State Service Mains Exam 2026 on the official website of the CGPSC on 01 September 2026. This recruitment was released for 238 posts. Applications for CGPSC SSE PCS Pre Recruitment 2025 were filled from 01 December 2025 to 30 December 2025. The written examination was conducted on 22 February 2026. Candidates who had qualified for this mains examination can download their CGPSC SSE State Service Exam Mains Result 2026 from the link given below.</span></p>\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Chhattisgarh Public Service Commission (CGPSC)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">CGPSC SSE State Service Exam Mains Result 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Advt No: 06/2025</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Notification Date : <strong>26 November 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>01 December 2025</strong></span></li>\n<li><span style=\"color: #000000; font-si