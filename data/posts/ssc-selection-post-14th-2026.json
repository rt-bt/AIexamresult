=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Region / Post Wise Vacancy Details<br>\n</b></span></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b><a title=\"Download SSC Selection Post 14th Notification PDF\" href=\"https://ssc.gov.in/rhq-selection-post/rhq-post-details\" target=\"_blank\" rel=\"noopener\">Click Here</a></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Download Syllabus</b></span><b></b></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Find More SSC Updates </b></span><b></b></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>For SSC OTR Registration </b></span><b></b></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #008080\"><b>Image Resizer, Resume CV Maker, Age Calculator and More Tools<br>\n</b></span></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"304\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Official Website</b></span></h2>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"300\">\n<h2 align=\"center\"><b><a title=\"SSC Official Website 2026\" href=\"https://ssc.gov.in/\" target=\"_blank\" rel=\"noopener\">SSC Official Website</a></b></h2>\n</td>\