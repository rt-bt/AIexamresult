b81ff\"><div class=\"gb-container gb-container-fcbb81ff\">\n\n<h4 class=\"gb-headline gb-headline-4ddaf9ee gb-headline-text\"><strong>Application Fee</strong></h4>\n\n\n<div class=\"gb-headline gb-headline-989f3ffd gb-headline-text\"><ul>\n<li><span style=\"font-size: 14pt;\"><strong>No Application Fee</strong></span></li>\n</ul>\n</div>\n</div></div>\n</div>\n</div>\n\n<div class=\"gb-container gb-container-6b6fbcac\">\n<div class=\"gb-grid-wrapper gb-grid-wrapper-8aa46b64\">\n<div class=\"gb-grid-column gb-grid-column-0f18d865\"><div class=\"gb-container gb-container-0f18d865\">\n<h5 class=\"gb-headline gb-headline-0b3ada47 gb-headline-text\">SWD UP IAS / PCS Free Coaching Notification 2026 : Age Limits As On SWD Rules.</h5>\n\n<div class=\"gb-headline gb-headline-28dede61 gb-headline-text\"><ul>\n<li><span style=\"color: #000000; font-size: 14pt;\">IAS Minimum Age : <strong>21 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 14pt;\">UPPSC Pre Minimum Age : <strong>21 years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 14pt;\">Age Relaxation as per Rules mentioned by <strong>SWD</strong> notification.</span></li>\n</ul>\n</div>\n</div></div>\n\n<div class=\"gb-grid-column gb-grid-column-860b2712\"><div class=\"gb-container gb-container-860b2712\">\n\n<h5 class=\"gb-headline gb-headline-f2184b83 gb-headline-text\"><strong>Total Post</strong></h5>\n\n\n<div class=\"gb-headline gb-headline-4259c0c2 gb-headline-text\">N/A</div>\n</div></div>\n</div>\n\n\n\n<!-- SarkariResult -->\n\n\n<div style=\"text-align:center;\">\n<a href=\"https://play.google.com/store/apps/details?id=com.vinod.sarkarinaukri&amp;hl=en_IN\" class=\"apply-button\" target=\"_blank\" rel=\"noopener\">\n        Download SarkariResult App Now\n    </a>\n    </div>\n    \n\n</div>\n\n\n\n<!-- SarkariResult -->\n\n\n\n\n<div class=\"gb-container gb-container-ec1f6e4c\">\n<h6 class=\"gb-headline gb-headline-c7683bda gb-headline-text\">SWD UP IAS / PCS Free Coaching 2026 : Admission Details</h6>\n\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%; height: 225px;\">\n<tbody>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; text-align: center; height: 25px;\"><span style=\"font-size: 14pt;\"><strong>Center Name</strong></span></td>\n<td style=\"width: 33.2383%; text-align: center; height: 25px;\"><span style=\"font-size: 14pt;\"><strong>No. Of Seats</strong></span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Chhatrapati Shahu Ji Maharaj Shodh Avam Prasikshan Sansthan Bhagidari Bhawan, Lucknow</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">250</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Adarsh Purva Prashikshan Kendra Aliganj, Lucknow (Only for Female)</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">150</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">IAS / PSC Coaching Center, Hapur Ghaziabad</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">150</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Sant Ravisas IAS / PSC Coaching Center Varanasi</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">75</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Dr B.R. Ambedkar Coaching, Agra</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">—</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Dr. B.R. Ambedkar Coaching, Aligarh</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">150</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Prayagraj Center</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">40</span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 66.7617%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">Gorakhpur Center</span></td>\n<td style=\"width: 33.2383%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">75</span></td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong>&nbsp;SWD UP IAS / PCS Free Coaching Admissions 2026 : Eligibility Criteria&nbsp;</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates belonging to OBC /SC/ST Category, Having Uttar Pradesh Domicile /hailing from Uttar Pradesh are eligible ,Bachelor degree holders in Any Stream &amp; Whose Annual Income is Less than 6 Lakh Per Annum are eligible for filling up this Free Coaching Online Application form</span></li>\n<li><span style=\"font-size: 14pt;\">Note – Applicants make sure that they are not previously enrolled in such kind of Coaching Institutes &amp; they are not engaged in any kind of Institute.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>&nbsp;</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody