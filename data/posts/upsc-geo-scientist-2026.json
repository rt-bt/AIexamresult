  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://upsc.gov.in/\" target=\"_blank\" rel=\"noopener nofollow\">Union Public Service Commission (UPSC)</a></span> has released the mains admit card for the post of Combined Geo Scientist Pre Examination 2025 on the official website of UPSC. This recruitment was released for 85 posts. Applications for the UPSC Geo-Scientist Recruitment 2025 were accepted from 03 September 2025 to 23 September 2025. The mains examination is going to be conducted on 20-21 June 2026. Candidates who qualified this pre examination can download their UPSC Geo-Scientist Mains Admit Card 2026 from the link given below.</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Union Public Service Commission (UPSC)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">UPSC Geo-Scientist Mains Admit Card 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">UPSC Geo Scientist Advt No. : 01/2026-GEOL</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>03 September 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>23 September 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Pre Exam Date : <strong>08 February 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Pre Admit Card : <strong>30 January 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Result : <strong>02 March 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Mains Exam Date : <strong>20-21 June 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Mains Admit Card : <strong>12 June 2026</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">General, OBC <strong>: Rs. 200/-</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">SC, ST, Female <strong>: 0/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>UPSC Combined Geo-Scientist Notification 2025 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Age Limit As On 01 January 2025</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Minimum Age :&nbsp;<strong>21 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Maximum Age :&nbsp;<strong>32 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per UPSC Combined Geo-Scientist Recruitment Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #000000; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>UPSC Combined Geo-Scientist 2025 : Vacancy Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Posts : 85 Posts</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>No. of Post</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Geologist Group A (Cat-I)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">39</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Geophysicist Group A (Cat-I)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">02</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Chemist Group A&nbsp;(Cat-I)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">15</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Hydrogeology)&nbsp;Group A&nbsp;(Cat-II)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">05</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Chemical)&nbsp;Group A&nbsp;(Cat-II)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">02</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Geophysics)&nbsp;Group A(Cat-II)</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">01</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Hydrogeologist, Group ‘B’</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">18</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Chemist, Group ‘B’</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">02</span></td>\n</tr>\n<tr>\n<td style=\"width: 58.2079%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Geophysicist, Group ‘B’</span></td>\n<td style=\"width: 41.7921%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">01</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>UPSC Combined Geo-Scientist Bharti 2025 : Educational Qualification</b></span></h3>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 68.1943%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Eligibility&nbsp;</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Geologist Group A (Cat-I)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Passed / Appearing Master Degree Geological&nbsp;&nbsp;<span class=\"google-anno-t\">Science</span>&nbsp;or Geology or Applied Geology or Geo-Exploration or Mineral Exploration or Engineering Geology or Marine Geology or Earth Science or Any Other Equivalent Degree</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Geophysicist Group A (Cat-I)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates Passed / Appearing Master Degree in Science in Following Stream Physics / Applied Physics / Geophysics / Marine Geophysics or Any Other Equivalent Degree</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Chemist Group A&nbsp;(Cat-I)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Master Degree in Science M.Sc Chemistry / Applied Chemistry / Analytical Chemistry Passed / Appearing in Any Recognized University in India.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Hydrogeology)&nbsp;Group A&nbsp;(Cat-II)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates Passed / Appearing (Final Year) Master degree in Geology or Applied Geology or Marine Geology or Any Equivalent Degree in Any Recognized University in India.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Chemical)&nbsp;Group A&nbsp;(Cat-II)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates Passed / Appearing (Final Year) Master degree in Geology or Applied Geology or Marine Geology or Any Equivalent Degree in Any Recognized University in India.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Scientist B (Geophysics)&nbsp;Group A(Cat-II)</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates Passed / Appearing (Final Year) Master degree in Geology or Applied Geology or Marine Geology or Any Equivalent Degree in Any Recognized University in India.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Hydrogeologist, Group ‘B’</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Master’s degree in Geology or applied Geology or Marine Geology or Hydrogeology from a Recognized University.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Chemist, Group ‘B’</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Master of Science or Integrated Master of Science in Chemistry or Applied Chemistry or Analytical Chemistry or Physical Chemistry or Inorganic Chemistry or Organic Chemistry or Hydro-Chemistry or Industrial Chemistry from a recognized university or institute.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 31.8057%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">Assistant Geophysicist, Group ‘B’</span></td>\n<td style=\"width: 68.1943%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Master of Science or Integrated Master of Science in Chemistry or Applied Chemistry or Analytical Chemistry or Physical Chemistry or Inorganic Chemistry or Organic Chemistry or Hydro-Chemistry or Industrial Chemistry from a recognized university or institute.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>UPSC Combined Geo-Scientist Online Form 2025 : </strong></span><span style=\"color: #000000;\"><strong>Mode of Selection</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Pre Exam</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Mains Exam</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Personality Test </span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Interview</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>How To Download UPSC Combined Geo Scientist Mains Admit Card 2026</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">In order to download their UPSC Combined Geo Scientist Mains Admit Card candidates are required to go to the important link section provided below.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">After getting the link candidates need to click it for downloading their UPSC Combined Geo Scientist Mains Admit Card.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates need to provide their following details-:</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Registration No. /Roll No.</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>DOB/Password</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>Captcha Code(if specified)</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">After providing their details appropriately candidates will be able to check their UPSC Combined Geo Scientist Mains Admit Card.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates can also check their UPSC Combined Geo Scientist Mains Admit Card from official site of the UPSC.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<div class=\"newtable2\">\n<table style=\"width: 100%;\">\n<tbody>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><strong>Follow SarkariExam on Instagram</strong></span></td>\n<td class=\"post-social-link\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"3\" data-align=\"center\"><strong><a href=\"https://instagram.com/sarkariexam.com_?igshid=YmMyMTA2M2Y=\" target=\"_blank\" rel=\"noopener\">Follow Now</a></strong></td>\n</tr>\n<tr>\n<td class=\"has-text-align-center\" style=\"text-align: center;\" colspan=\"4\" data-align=\"center\"><span style=\"color: #cc0052;\"><b>Join Our WhatsApp Channel</b></span></td>\n<td class=\"post-social-link\" style=\"text-align: center;\" colspan=\"3\" data-align=\"center\"><strong><a href=\"https://whatsapp.com/channel/0029VaAbQf01NCrYADMLt00L\" target=\"_blank\" rel=\"noopener nofollow\">Follow Now</a></strong></td>\n</tr>\n<tr>\n<td style=\"text-align: center; padding: 0px;\" colspan=\"7\" width=\"100%\">\n<h3><strong>Important Links</strong></h3>\n</td>\n</tr>\n<tr>\n<td class=\"tcell\" style=\"text-align: center; padding: 10px 0px;\" colspan=\"4\" width=\"56%\">\n<h4><span style=\"color: #800000;\"><strong>Download Ma