e: 12pt; color: #000000;\">BC</span></td>\n<td style=\"width: 26.3756%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">140</span></td>\n</tr>\n<tr>\n<td style=\"width: 26.7848%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">BC-Female</span></td>\n<td style=\"width: 26.3756%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">36</span></td>\n</tr>\n<tr>\n<td style=\"width: 26.7848%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">SC</span></td>\n<td style=\"width: 26.3756%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">175</span></td>\n</tr>\n<tr>\n<td style=\"width: 26.7848%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">ST</span></td>\n<td style=\"width: 26.3756%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">10</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>BPSC 72nd Pre Online Form 2026 : Post Wise Vacancy Details</b></span></h3>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>No. of Posts</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">72nd Combined (Preliminary Competitive) Examination</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">1033</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Child Development Project Officer</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">20</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Financial Administrative Officer &amp; Equivalent</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">32</span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Sub-Divisional Protection Officer</span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">101</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>BPSC 72nd Pre Online Form 2026 : Educational Qualification</b></span></h3>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 29.6726%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 70.3274%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Eligibility&nbsp;</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 29.6726%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">72nd Combined (Preliminary Competitive) Examination</span></td>\n<td style=\"width: 70.3274%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates must have passed <strong data-start=\"94\" data-end=\"157\">Graduation (Bachelor’s Degree) or an equivalent examination</strong> from a recognized university.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 29.6726%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Child Development Project Officer</span></td>\n<td style=\"width: 70.3274%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates must possess a <strong data-start=\"219\" data-end=\"269\">Bachelor’s Degree from a recognized university</strong> and must choose <strong data-start=\"286\" data-end=\"310\">one optional subject</strong> for the main examination from the following:</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Home Science</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Psychology</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Sociology</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Labour &amp; Social Welfare</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 29.6726%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Financial Administrative Officer &amp; Equivalent</span></td>\n<td style=\"width: 70.3274%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates must have a <strong data-start=\"477\" data-end=\"557\">Bachelor’s Degree from a recognized university or its affiliated institution</strong> in any one of the following subjects:</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong data-start=\"600\" data-end=\"652\">Commerce, Economics, Mathematics, or Statistics.</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 29.6726%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">Sub-Divisional Protection Officer</span></td>\n<td style=\"width: 70.3274%;\">\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates must possess a<strong data-start=\"683\" data-end=\"733\"> Bachelor’s Degree from a recognized university</strong> in either <strong data-start=\"744\" data-end=\"765\">Psychology or Law</strong>. Additionally, candidates must choose <strong data-start=\"808\" data-end=\"832\" data-is-only-node=\"\">one optional subject</strong> for the main examination from:</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Psychology</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Law</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<t