  "fullContentHtml": "<div class=\"gb-container gb-container-b39c368c\">\n\n<div>\n<div>\n<center>\n<!-- Internal_head_07-11-2024 -->\n\n</center>\n</div>\n</div>\n\n\n<div class=\"gb-headline gb-headline-3a6be1b8 gb-headline-text\"><table style=\"border-collapse: collapse;width: 100%;height: 225px\">\n<tbody>\n<tr style=\"height: 36px\">\n<td style=\"width: 22.6212%;text-align: center;height: 36px;border-style: none\"><span style=\"color: #ff0000\"><strong>Name Of Post :</strong></span></td>\n<td style=\"width: 77.3788%;height: 36px;border-style: none\">\n<h1><span style=\"color: #ff0000\"><strong>All India Bar Examination AIBE 22nd Examination 2026 Apply Online</strong></span></h1>\n</td>\n</tr>\n<tr style=\"height: 22px\">\n<td style=\"width: 22.6212%;text-align: center;height: 35px;border-style: none\"><span style=\"color: #ff0000\"><strong>Post Date / Update :</strong></span></td>\n<td style=\"width: 77.3788%;height: 35px;border-style: none\">20 August 2026 | 09:00 PM</td>\n</tr>\n<tr style=\"height: 154px\">\n<td style=\"width: 22.6212%;text-align: center;height: 154px;border-style: none\"><span style=\"color: #ff0000\"><strong>Short Information </strong></span></td>\n<td style=\"width: 77.3788%;height: 154px;border-style: none;vertical-align: middle\">\n<p style=\"text-align: left\">All India Bar Examination AIBE 22nd has released the online application for AIBE XXII 2026 will start from <strong>19 August 2026</strong> and the last date to apply will be <strong>27 October 2026.</strong>candidates should read the AIBE XXII 2026 information brochure for all the information related to the AIBE exam like syllabus, eligibility, age limit, fees, information and other types of information and then apply.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n<center>\n<!-- SR26042026_Square -->\n\n</center>\n\n\n\n\n\n<div class=\"social-grid\">\n\n<div class=\"social-box telegram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-ico