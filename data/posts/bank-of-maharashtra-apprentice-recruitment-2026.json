  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> Bank Of Maharashtra</span> has released the notification for the post of Apprentice. This recruitment has been issued for 600 posts. Online applying process for Bank of Maharashtra Apprentice Recruitment 2026 has started from 15 January 2026 &amp; the candidates can apply till 25 January 2026. Candidates must check the complete details for Bank of Maharashtra Apprentice Recruitment 2026 which has given below.&nbsp;</span></p>\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Bank Of Maharashtra</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">Bank of Maharashtra Apprentice Recruitment 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Advt No. : AX1/ST/RP/Apprentices/Notification/2025-26</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>15 January 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <span style=\"color: #ff0000;\"><strong>25 January 2026</strong></span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>25 January 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam Date : <strong>Notify Later</strong></span></li>\n<li><span 