me page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>SSB Head Constable Ministerial Notification 2021 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\">Minimum Age :&nbsp;<strong>18 Years</strong></span></li>\n<li><span style=\"font-size: 12pt;\">Maximum Age :&nbsp;<strong>25 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per SSB Head Constable Ministerial Recruitment Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #000000; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>SSB Head Constable Ministerial 2021 : Vacancy Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Posts : 115 Posts</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 43.9744%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 28.1492%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Category&nbsp;</strong></span></td>\n<td style=\"width: 27.8763%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>No. of Posts</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 43.9744%; text-align: center;\" rowspan=\"5\"><span style=\"color: #000000; font-size: 12pt;\">Head Constable (Ministerial)</span></td>\n<td style=\"width: 28.1492%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">General&nbsp;</span></td>\n<td style=\"width: 27.8763%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">47</span></td>\n</tr>\n<tr>\n<td style=\"w