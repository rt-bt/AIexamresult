  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> &nbsp;</span>has released the notification for the post of Apprentice. This recruitment has been issued for 4500 posts.&nbsp; Online applying process for Central Bank of India Apprentices Recruitment 2026 has started on 12 June 2026 &amp; the candidates can apply till 22 June 2026. Candidates must check the complete details for Central Bank of India Apprentices Recruitment 2026 which has given below.</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Central Bank of India (CBI)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">Central Bank of India Recruitment 2026</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Online Apply Start Date :&nbsp;<strong>12 June 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Online Apply Last Date :&nbsp;<span style=\"color: #ff0000;\"><strong>22 June 2026</strong></span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date For Fee Payment : <strong>22</strong><strong> June 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam Date<strong> : Notify Soon</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card :&nbsp;<strong>Before Exam</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Result Date :&nbsp;<strong>Will Be Updated Here Soon</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">General, OBC, EWS :&nbsp;<strong>₹ 944/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">General, OBC, EWS Female :&nbsp;<strong>₹ 708/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">SC, ST, PH : <strong>₹ 236/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\"></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n<p></p><div class=\"code-block code-block-3\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Central Bank of India Apprentices Notification 2026 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\"><strong><span style=\"color: #000000;\">Age Limit As On </span></strong><span style=\"color: #000000;\"><strong>31 May 2026</strong></span></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Minimum Age :&nbsp;<strong>20 Years</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Maximum Age :&nbsp;<strong>28 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per Central Bank of India Apprentices Recruitment Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #000000; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Central Bank of India Apprentices 2026 : Vacancy Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Posts : 4500 Posts</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%; height: 144px;\">\n<tbody>\n<tr style=\"height: 24px;\">\n<td style=\"width: 33.3333%; text-align: center; height: 24px;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center; height: 24px;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>Category</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center; height: 24px;\"><span style=\"color: #000000; font-size: 12pt;\"><strong>No. Of Post</strong></span></td>\n</tr>\n<tr style=\"height: 24px;\">\n<td style=\"width: 33.3333%; text-align: center; height: 120px;\" rowspan=\"5\"><span style=\"color: #000000; font-size: 12pt;\">Apprentice</span></td>\n<td style=\"width: 33.3333%; height: 24px; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">General&nbsp;</span></td>\n<td style=\"width: 33.3333%; height: 24px; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">1903</span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">EWS</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\"> 454</span></td>\n</tr>\n<tr style=\"height: 24px;\">\n<td style=\"width: 33.3333%; height: 24px; text-align: center;\"><span style=\"color: #000000; font-size: 12pt;\">OBC</span></td>\n<td style=\"width: 33.3333%