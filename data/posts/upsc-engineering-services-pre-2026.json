  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://upsc.gov.in/\" target=\"_blank\" rel=\"noopener nofollow\">Union Public Service Commission (UPSC)</a> </span>has released the mains admit card for the post of Engineering Service Examination 2026 on the official website of UPSC. This recruitment was released for 474 posts. Applications for the UPSC Engineering Services Recruitment 2025 were accepted from September 26, 2025, to October 16, 2025. The mains is going to be conducted on 21 June 2026. 08 February 2025. Candidates who had qualified for this pre examination can download their UPSC Engineering Services Mains Admit Card 2026 from the link given below.</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Union Public Service Commission (UPSC)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">UPSC Engineering Services Mains Admit Card 2026</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Advt No. : 02/2026 ENGG.</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>26 September 2025</strong></span></li>\n<li><span style=\"font-size: 12pt; 