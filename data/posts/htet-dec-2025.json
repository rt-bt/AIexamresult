  "fullContentHtml": "<div class=\"gb-container gb-container-b39c368c\">\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%; height: 225px;\">\n<tbody>\n<tr style=\"height: 36px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 36px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Name Of Post :</strong></span></td>\n<td style=\"width: 77.3788%; height: 36px; border-style: none;\">\n<h1><strong>BSEH Haryana Teacher Eligibility Test HTET Exam Date 2026</strong></h1>\n</td>\n</tr>\n<tr style=\"height: 22px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 35px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Post Date / Update :</strong></span></td>\n<td style=\"width: 77.3788%; height: 35px; border-style: none;\">04 June 2026 | 03:36 PM</td>\n</tr>\n<tr style=\"height: 154px;\">\n<td style=\"width: 22.6212%; text-align: center; height: 154px; border-style: none;\"><span style=\"color: #ff0000;\"><strong>Short Information </strong></span></td>\n<td style=\"width: 77.3788%; height: 154px; border-style: none; vertical-align: middle;\">\n<p style=\"text-align: left;\">Board of Secondary Education, BSEH Haryana has released the detailed notification of Haryana Teacher Eligibility Test December 2025 exam. All the candidates who are interested in this HTET 2025 exam and want to apply can apply online between 24 December 2025 to 05 January 2026. Read the notification for other information like qualification, age limit, syllabus, sample question paper, OMR sheet and all other information.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n\n\n<div class=\"social-grid\">\n\n<div class=\"social-box telegram\">\n    <div class=\"social-left\">\n        <img fetchpriority=\"high\" decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/2111/2111646.png\">\n        <span>Telegram</span>\n    </div>\n    <a href=\"https://t.me/SarkariResult2012\" class=\"social-btn\">Join Us</a>\n</div>\n\n<div class=\"social-box whatsapp\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/733/733585.png\">\n        <span>WhatsApp</span>\n    </div>\n    <a href=\"https://www.whatsapp.com/channel/0029Va5IElwBlHpVBd6i5a18\" class=\"social-btn\">Join Us</a>\n</div>\n\n<div class=\"social-box instagram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/2111/2111463.png\">\n        <span>Instagram</span>\n    </div>\n    \n</div>\n\n<div class=\"social-box twitter\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/5968/5968958.png\">\n        <span>X</span>\n    </div>\n    <a href=\"https://x.com/srofficial2012\" class=\"social-btn\">Follow</a>\n</div>\n\n</div>\n\n\n\n<div id=\"v-sarkariresult\"></div>\n\n\n\n\n<div class=\"gb-headline gb-headline-48617a69 gb-headline-text\"><p>&nbsp;</p>\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Board of Secondary Education, BSEH Haryana</b></span><b></b></h2>\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Haryana Teacher Eligibility Test (HTET 2025) Online Form</b></span><b></b></h2>\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>HTET Exam December 2025 : Short Details of Notification</b></span></h2>\n<h2 align=\"center\"><span style=\"color: #ff0000;\"><b></b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" rowspan=\"6\" valign=\"top\" width=\"320\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Important Dates</b></span><b></b></h2>\n<ul>\n<li>Application Begin :<b> 24/12/2025<br>\n</b></li>\n<li>Last Date for Apply Online : <span style=\"color: #ff0000;\"><b>05/01/2026</b></span></li>\n<li>Pay Exam Fee Last Date : <b>05/01/2026</b></li>\n<li>Correction Date :&nbsp; <strong>04-05 January 2026<br>\n</strong></li>\n<li>Exam Date : <b>04-05 July 2026<br>\n</b></li>\n<li>Admit Card Available : <b>Before Exam<br>\n</b></li>\n</ul>\n</td>\n<td colspan=\"3\" valign=\"top\" width=\"325\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Application Fee </b></span></h2>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"77\">\n<p align=\"center\"><b>Paper</b></p>\n</td>\n<td valign=\"top\" width=\"174\">\n<p align=\"center\"><b>Gen. / OBC / Other State</b></p>\n</td>\n<td valign=\"top\" width=\"74\">\n<p align=\"center\"><b>SC/ PH</b></p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"77\">\n<p align=\"center\">Single</p>\n</td>\n<td valign=\"top\" width=\"174\">\n<p align=\"center\">1000/-</p>\n</td>\n<td valign=\"top\" width=\"74\">\n<p align=\"center\">500/-</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"77\">\n<p align=\"center\">Double</p>\n</td>\n<td valign=\"top\" width=\"174\">\n<p align=\"center\">1800/-</p>\n</td>\n<td valign=\"top\" width=\"74\">\n<p align=\"center\">900/-</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"77\">\n<p align=\"center\">Triple</p>\n</td>\n<td valign=\"top\" width=\"174\">\n<p align=\"center\">2400/-</p>\n</td>\n<td valign=\"top\" width=\"74\">\n<p align=\"center\">1200/-</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"325\">\n<ul>\n<li>Pay the Examination Fee Through Debit Card, Credit Card, Net Banking Fee Mode Only.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Haryana TET HTET 2025 Notification : <span style=\"color: #ff00ff;\">Eligibility Details</span></b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"147\">\n<p align=\"center\"><b>HTET Level I Class 1-5 PRT Teacher</b></p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"498\">\n<ul>\n<li>10+2 Intermediate with 50% Marks and Passed / Appearing 2 Year Diploma in Elementary Education / Special Education / B.E.Ed &nbsp;<strong>OR</strong></li>\n<li>10+2 Intermediate with 45% Marks and Passed / Appearing 2 Year Diploma in Elementary Education / Special Education / B.E.Ed &nbsp;<strong>OR</strong></li>\n<li>Bachelor Degree in Any Stream &nbsp;and Passed / Appearing 2 Year Diploma in Elementary Education / Special Education / B.E.Ed<strong>.</strong></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"147\">\n<p align=\"center\"><b>HTET Level II TGT Teacher Class 6 to 8</b></p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"498\">\n<ul>\n<li>Bachelor Degree in Any Stream with 50% Marks and 2 Year Diploma in Education /&nbsp; Elementary Education <strong>OR</strong></li>\n<li>Bachelor Degree with 50% Marks and B.Ed / Special B.Ed Degree <strong>OR</strong></li>\n<li>10+2 with 50% Marks and 4 Year BA B.Ed / B.Com B.Ed Degree.</li>\n<li>For More Details Read Full Notification.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"147\">\n<p align=\"center\"><b>HTET Level III&nbsp; PGT Teacher</b></p>\n</td>\n<td colspan=\"5\" valign=\"top\" width=\"498\">\n<ul>\n<li>Master Degree in Concerned Subject with 50% Marks and &nbsp;B.Ed Degree.</li>\n<li>For Subject Wise Eligibility Details Read the Notification.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>How to Fill Haryana Teacher Eligibility Test HTET Online Form 2025<br>\n</b></span></h2>\n<ul>\n<li>Board of Secondary Education BSEH, Haryana Released Haryana Teacher Eligibility Test HTET 2025. Notification and Invited Online Application Form for the HTET Examination December 2025. Candidate Can Apply Online for <b>24/12/2025 to 05/01/2026.<br>\n</b></li>\n<li>Candidate Read the Notification Before Apply the Latest Haryana TET HTET 2025 Application Form in Sarkari Result Latest Job Section.</li>\n<li>Kindly Check and Collect the All Document – Hand Writing, Eligibility, ID Proof, Address Details, Basic Details.</li>\n<li>Kindly Ready Scan Document Related to Recruitment Form – Photo, Sign, ID, Thumb, Proof, Etc.</li>\n<li>Before Submit the Application Form Must Check the Preview and All Column Carefully.</li>\n<li>If Candidate Required to Paying the Application Fee Must Submit. If You have Not the Required Application Fees Your Form is Not Completed.</li>\n<li>Take A Print Out of Final Submitted Form.</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\"><center><br>\n<!-- 300 x 250 mar 23 --><br>\n<br>\n</center><p></p>\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Interested Candidate Can Read the Full HTET 2025 Notification Before Apply Online.</b></span></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"6\" valign=\"top\" width=\"645\">\n<h2 align=\"center\"><span style=\"color: #008000;\"><b>Some Useful Important Links</b></span><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Exam Notice</b></span><b></b></h2>\n</td>\n<td colspan=\"4\">\n<h2 align=\"center\"><a title=\"HTET 2025 Exam Date\" href=\"https://htet.eapplynow.com/\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a><b></b></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Apply Online</b></span><b></b></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n<h2 align=\"center\"><a title=\"HTET December 2024 Registration\" href=\"https://htet.eapplynow.com/\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Notification</b></span><b></b></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n<h2 align=\"center\"><a title=\"HTET December 2024 Registration\" href=\"https://htet.eapplynow.com/HTET25_InfoBulletin.pdf\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Download Syllabus</b></span></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n<h2 align=\"center\"><a title=\"HTET December 2024 Registration\" href=\"https://tinyurl.com/a526wzpz\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #008080;\"><b>Remove Background, Image Resizer, Resume CV Maker, JPG to PDF and More<br>\n</b></span></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n<h2 align=\"center\"></h2>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #008080;\"><b>Join Our Channel</b></span><b></b></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"316\">\n<h2 align=\"center\"><span style=\"color: #ff00ff;\"><b>Official Website</b></span></h2>\n</td>\n<td colspan=\"4\" valign=\"top\" width=\"329\">\n<h2 align=\"center\"><b><a title=\"Haryana TET BSEH Official Website 2026\" href=\"https://bseh.org.in/\" target=\"_blank\" rel=\"noopener\">BSEH Official Website</a></b></h2>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n<div class=\"gb-container gb-container-6da1cb96\">\n\n<h3 class=\"gb-headline gb-headline-325acb59\"><span class=\"gb-icon\"><svg aria-hidden=\"true\" role=\"img\" height=\"1em\" width=\"1em\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path fill=\"currentColor\" d=\"M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.