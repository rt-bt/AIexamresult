  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong> <a style=\"color: #ff0000;\" href=\"https://iocl.com/\" target=\"_blank\" rel=\"noopener nofollow\">Indian Oil Corporation Limited (IOCL)</a> </span>has released the short notice for the post of Apprentice. This recruitment has been issued for 1770 posts. Online applying process for IOCL Refineries Division Recruitment 2025 has started from 03 May 2025 &amp; the candidates can apply till 02 June 2025. Candidates must check the complete details for IOCL Refineries Division Recruitment 2025 which has given below.&nbsp;</span></p><div class=\"code-block code-block-2\" style=\"margin: 8px 0; clear: both;\">\n\n<!-- SarkariExam Home page -->\n\n</div>\n\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Indian Oil Corporation Limited (IOCL)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">IOCL Refineries Division Recruitment 2025</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>03 May 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <span style=\"color: #ff0000;\"><strong>02 June 2025</strong></span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Merit List : <strong>Notify Later</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td cl