  "fullContentHtml": "<div class=\"gb-container gb-container-b39c368c\">\n\n<div>\n<div>\n<center>\n<!-- Internal_head_07-11-2024 -->\n\n</center>\n</div>\n</div>\n\n\n<div class=\"gb-headline gb-headline-3a6be1b8 gb-headline-text\"><table style=\"border-collapse: collapse;width: 100%;height: 225px\">\n<tbody>\n<tr style=\"height: 36px\">\n<td style=\"width: 22.6212%;text-align: center;height: 36px;border-style: none\"><span style=\"color: #ff0000\"><strong>Name Of Post :</strong></span></td>\n<td style=\"width: 77.3788%;height: 36px;border-style: none\">\n<h1><span style=\"color: #ff0000\"><strong>HPPSC H.P. Administrative Service Combined Competitive Recruitment 2026 Apply Online for 22 Post&nbsp;</strong></span></h1>\n</td>\n</tr>\n<tr style=\"height: 22px\">\n<td style=\"width: 22.6212%;text-align: center;height: 35px;border-style: none\"><span style=\"color: #ff0000\"><strong>Post Date / Update :</strong></span></td>\n<td style=\"width: 77.3788%;height: 35px;border-style: none\">28 August 2026 | 07:30 PM</td>\n</tr>\n<tr style=\"height: 154px\">\n<td style=\"width: 22.6212%;text-align: center;height: 154px;border-style: none\"><span style=\"color: #ff0000\"><strong>Short Information </strong></span></td>\n<td style=\"width: 77.3788%;height: 154px;border-style: none;vertical-align: middle\">\n<p style=\"text-align: left\">Himachal Pradesh Public Service Comission (HPPSC) has released notification for HPPSC Himachal Pradesh Administrative Service Combined Competitive Recruitment Test 2026. Those candidates who are interested in this HPPSC HPAS Examination 2026 Can Apply Online from <strong>26/08/2026 to 22/09/2026</strong>. Read the notification for Recruitment eligibility, post information, selection procedure, age limit, Post list, Vacancy details, and all other information.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n<center>\n<!-- SR26042026_Square -->\n\n</center>\n\n\n\n\n\n<div class=\"social-grid\">\n\n<div class=\"social-box telegram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/2111/2111646.png\">\n        <span>Telegram</span>\n    </div>\n    <a href=\"https://t.me/SarkariResult2012\" class=\"social-btn\">Join Us</a>\n</div>\n\n<div class=\"social-box whatsapp\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/733/733585.png\">\n        <span>WhatsApp</span>\n    </div>\n    <a href=\"https://www.whatsapp.com/channel/0029Va5IElwBlHpVBd6i5a18\" class=\"social-btn\">Join Us</a>\n</div>\n\n<div class=\"social-box instagram\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/2111/2111463.png\">\n        <span>Instagram</span>\n    </div>\n    \n</div>\n\n<div class=\"social-box twitter\">\n    <div class=\"social-left\">\n        <img decoding=\"async\" src=\"https://cdn-icons-png.flaticon.com/512/5968/5968958.png\">\n        <span>X</span>\n    </div>\n    <a href=\"https://x.com/srofficial2012\" class=\"social-btn\">Follow</a>\n</div>\n\n</div>\n\n\n\n<div id=\"v-sarkariresult\"></div>\n\n\n\n\n<div class=\"gb-headline gb-headline-48617a69 gb-headline-text\"><table style=\"border-collapse: collapse;width: 100%;height: 1459px\">\n<tbody>\n<tr style=\"height: 232px\">\n<td style=\"width: 153.097%;height: 232px\" colspan=\"10\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Himachal Pradesh Public Service Commission&nbsp;</b></span><b></b></h2>\n<h2 align=\"center\"><span style=\"color: #008000\"><strong>HPPSC H.P. Administrative Service Combined Competitive Online Form 2026</strong></span></h2>\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>HPPSC Advt No 59/8-2026 : Short Details of Notification</b></span></h2>\n<h2 align=\"center\"><span style=\"color: #ff0000\"><b></b></span></h2>\n</td>\n</tr>\n<tr style=\"height: 209px\">\n<td style=\"width: 51.8732%;height: 209px\" colspan=\"5\">\n<h3 align=\"center\"><span style=\"color: #008000\"><b>Important Dates</b></span><b></b></h3>\n<ul>\n<li>Application Begin : <b>26/08/2026</b></li>\n<li>Last Date for Apply Online : <span style=\"color: #ff0000\"><b>22/09/2026</b></span></li>\n<li>Pay Exam Fee Last Date : <b>22/09/2026</b></li>\n<li>HPPSC HPAS Exam Date :<span style=\"color: #000000\"><b> As Per Schedule&nbsp;</b></span></li>\n<li>Admit Card Available : <b>As Per Schedule</b></li>\n<li>Result Available : <strong>As per Schedule</strong></li>\n</ul>\n</td>\n<td style=\"width: 101.224%;height: 209px\" colspan=\"5\">\n<h3 align=\"center\"><span style=\"color: #008000\"><b>Application Fee</b></span><b></b></h3>\n<ul>\n<li>All Category Candidates : <b>600/-</b></li>\n<li>Pay the Exam Fee Through Online / Offline Fee Mode Only</li>\n</ul>\n</td>\n</tr>\n<tr style=\"height: 12px\">\n<td style=\"width: 153.097%;height: 12px\" colspan=\"10\">\n<h2 align=\"center\"><span style=\"color: #008000\"><b>HPPSC HPAS Online Form 2026 : </b><span style=\"color: #ff00ff\"><b>Age Limit as on 01/01/2026</b></span></span><b></b></h2>\n<ul>\n<li>Minimum Age : <b>21 Years</b></li>\n<li>Maximum Age : <b>35 Years</b></li>\n<li>Age Relaxation Extra as per HPPSC H.P. Administrative Service Combined Competitive Examination Rules 2026.</li>\n</ul>\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"width: 153.097%;height: 10px\" colspan=\"10\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>HPPSC HPAS Recruitment 2026 : </b><span style=\"color: #008000\"><b>Vacancy Details Total : 22 Post</b></span></span></h2>\n</td>\n</tr>\n<tr style=\"height: 25px\">\n<td style=\"text-align: center;width: 30.5934%;height: 25px\" colspan=\"3\"><strong>Post Name</strong></td>\n<td style=\"text-align: center;width: 21.2798%;height: 25px\" colspan=\"2\"><strong>Total Post</strong></td>\n<td style=\"text-align: center;width: 101.224%;height: 25px\" colspan=\"5\"><strong style=\"font-family: inherit;font-size: inherit\">HPPSC HPAS Eligibility 2026</strong><strong><br>\n</strong></td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"text-align: center;height: 10px\" colspan=\"3\">H.P. Administrative Service</td>\n<td style=\"text-align: center;height: 10px\" colspan=\"2\">04</td>\n<td style=\"text-align: center;height: 10px\" colspan=\"5\" rowspan=\"5\">\n<ul>\n<li style=\"text-align: left\">Bachelor Degree in Any Stream in Any Recognized Board in India.</li>\n<li style=\"text-align: left\">Knowledge of customs, manners and dialects of Himachal Pradesh.</li>\n<li style=\"text-align: left\">For More Eligibility Details Read the Notification.</li>\n</ul>\n</td>\n</tr>\n<tr style=\"height: 110px\">\n<td style=\"text-align: center;height: 110px\" colspan=\"3\">Block Development Officer</td>\n<td style=\"text-align: center;height: 110px\" colspan=\"2\">10</td>\n</tr>\n<tr style=\"height: 110px\">\n<td style=\"text-align: center;height: 110px\" colspan=\"3\">District Controller</td>\n<td style=\"text-align: center;height: 110px\" colspan=\"2\">01</td>\n</tr>\n<tr style=\"height: 110px\">\n<td style=\"text-align: center;height: 110px\" colspan=\"3\">District Treasury Officer</td>\n<td style=\"text-align: center;height: 110px\" colspan=\"2\">01</td>\n</tr>\n<tr style=\"height: 110px\">\n<td style=\"text-align: center;width: 30.5934%;height: 110px\" colspan=\"3\">Tehsildar</td>\n<td style=\"text-align: center;width: 21.2798%;height: 110px\" colspan=\"2\">06</td>\n</tr>\n<tr style=\"height: 263px\">\n<td style=\"height: 263px\" colspan=\"10\">\n\n<ul>\n<li>Himachal Pradesh Public Service Commission Are Issued H.P. Administrative Service Combined Competitive HPAS Vacancy 2026. Notification and Invited Online Application Form for the H.P. Administrative Service Combined Competitive HPAS Recruitment 2026 Candidate Can Apply Online for <b>26/08/2026 to 22/09/2026.</b></li>\n<li>Candidate Read the Notification Before Apply the HPPSC Latest Recruitment 2026 Application Form in Sarkari Result Recruitment Latest Job Section.</li>\n<li>Kindly Check and Collect the All Document – Hand Writing, Eligibility, ID Proof, Address Details, Basic Details.</li>\n<li>Kindly Ready Scan Document Related to Recruitment Form – Photo, Sign, ID, Thumb, Proof, Etc.</li>\n<li>Before Submit the Application Form Must Check the Preview and All Column Carefully.</li>\n<li>If Candidate Required to Paying the Application Fee Must Submit. If You have Not the Required Application Fees Your Form is Not Completed.</li>\n<li>Take A Print Out of Final Submitted Form.</li>\n<li>For the latest updates on Sarkari Result, admit card, answer key, and result, always visit SarkariResult.com, the official website for Sarkari Result in India (Since 2012).</li>\n</ul>\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"width: 153.097%;height: 10px\" colspan=\"10\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Interested Candidates Can Read the Full PNB LBO 2026 Notification Before Apply Online.</b></span><b></b></h2>\n</td>\n</tr>\n<tr style=\"height: 49px\">\n<td style=\"width: 153.097%;height: 49px\" colspan=\"10\">\n\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"width: 51.8732%;height: 10px\" colspan=\"5\">\n\n</td>\n<td style=\"width: 101.224%;height: 10px\" colspan=\"5\">\n\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"width: 153.097%;text-align: center;height: 10px\" colspan=\"10\">\n<h2 align=\"center\"><span style=\"color: #008000\"><b>Some Useful Important Links</b></span></h2>\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"text-align: center;height: 10px\" colspan=\"5\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Apply Online</b></span><b></b></h2>\n</td>\n<td style=\"height: 10px\" colspan=\"5\">\n<h2 align=\"center\"><b><a title=\"Apply Online HPPSC HPAS Registration 2026\" href=\"https://hppsconline.hp.gov.in/HPPSC/ApplicantRegistration/Home/Login\" target=\"_blank\" rel=\"noopener\">Click Here</a></b></h2>\n</td>\n</tr>\n<tr style=\"height: 62px\">\n<td style=\"text-align: center;height: 62px\" colspan=\"5\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>How To Fill Form (Hindi Video)</b></span><b></b></h2>\n</td>\n<td style=\"height: 62px\" colspan=\"5\">\n<h2 align=\"center\"><a title=\"HPPSC HPAS Notification 2026\" href=\"https://youtu.be/II1SB2-QBwY\" target=\"_blank\" rel=\"noopener\"><b>Watch Video</b></a><b></b></h2>\n</td>\n</tr>\n<tr style=\"height: 14px\">\n<td style=\"text-align: center;height: 14px\" colspan=\"5\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Download Notification</b></span><b></b></h2>\n</td>\n<td style=\"height: 14px\" colspan=\"5\">\n<h2 align=\"center\"><a title=\"HPPSC HPAS Notification 2026\" href=\"https://hppsc.hp.gov.in/CommonControls/ViewCMSFile?qs=KI3gZ53zz1wSGo29lXLTBfw1DHezN8KfEg%2BrikZhi%2FLLqiZME0%2BQReThfPJPy%2BjgJhsSzNLtXQgyrhjwChomkO7eONOEFu3udXmeG2YxYmM%3D\" target=\"_blank\" rel=\"noopener\"><b>Click Here</b></a></h2>\n</td>\n</tr>\n<tr style=\"height: 73px\">\n<td style=\"text-align: center;width: 51.8732%;height: 73px\" colspan=\"5\">\n<h2 align=\"center\"><span style=\"color: #008080\"><b>Signature Resizer, PDF Compress, Age Calculator and More Tools</b></span></h2>\n</td>\n<td style=\"width: 101.224%;height: 73px\" colspan=\"5\">\n<h2 align=\"center\"><b></b></h2>\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"text-align: center;width: 51.8732%;height: 10px\" colspan=\"5\">\n\n</td>\n<td style=\"width: 101.224%;height: 10px\" colspan=\"5\">\n\n</td>\n</tr>\n<tr style=\"height: 10px\">\n<td style=\"width: 51.8732%;text-align: center;height: 10px\" colspan=\"5\">\n<h2 align=\"center\"><span style=\"color: #ff00ff\"><b>Official Website</b></span></h2>\n</td>\n<td style=\"width: 101.224%;height: 10px\" colspan=\"5\">\n<h2 align=\"center\"><b><a title=\"HPPSC Official Website\" href=\"https://hppsc.hp.gov.in/\" target=\"_blank\" rel=\"noopener\">HPPSC Official Website</a></b></h2>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n\n\n<div>\n\n<!-- Internal_header_07-11-2024 -->\n\n\n</div>\n\n\n<div class=\"gb-container gb-container-6da1cb96\">\n\n<h3 class=\"gb-headline gb-headline-325acb59\"><span class=\"gb-icon\"><svg aria-hidden=\"true\" role=\"img\" height=\"1em\" width=\"1em\" viewBox=\"0 0 448 512\" xmlns=\"http://www.w3.org/2000/svg\"><path fill=\"currentColor\" d=\"M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z\"></path></svg></span><span class=\"gb-headline-text\"><strong><em>Frequently Asked Questions</em></strong></span></h3>\n\n\n<div class=\"gb-headline gb-headline-97950a91 gb-headline-text\"><h5 style=\"text-align: left\" data-section-id=\"1nlecbm\" data-start=\"39\" data-end=\"96\"><span style=\"color: #ff00ff\"><strong>Q1. When did the HPPSC HPAS Online Application Process 2026 Start?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"97\" data-end=\"178\">The online application process started on <strong data-start=\"727\" data-end=\"743\">26 August 2026</strong>.</li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"1e84k3r\" data-start=\"435\" data-end=\"474\"><span style=\"color: #008000\"><strong>Q2.</strong><strong>What is the Exam Date for HPPSC HPAS Exam 2026 ?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"475\" data-end=\"553\">The Examination will be conducted in <strong>As Per Schedule</strong>.</li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"o0mtqe\" data-start=\"555\" data-end=\"592\"><span style=\"color: #ff00ff\"><strong>Q3. Where can I find the syllabus for the HPPSC HPAS Examination 2026?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"593\" data-end=\"655\">The detailed syllabus and examination scheme are available in the official notification. Candidates are advised to read the notification carefully for complete details.</li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"o0mtqe\" data-start=\"555\" data-end=\"592\"><span style=\"color: #008000\"><strong>Q4. How can I download the HPPSC HPAS Notification 2026 PDF?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"593\" data-end=\"655\">Candidates can download the notification through SarkariResult.com.</li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"kyy6a2\" data-start=\"180\" data-end=\"221\"><span style=\"color: #ff00ff\"><strong>Q5. What is the last date to apply online for HPPSC HPAS 2026?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"222\" data-end=\"305\">The last date to apply online is <strong>22 September 2026.</strong></li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"1dih1sd\" data-start=\"307\" data-end=\"359\"><span style=\"color: #008000\"><strong>Q6. What is the last date to pay the application fee?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"360\" data-end=\"433\">Candidates can pay the application fee up to <strong data-start=\"742\" data-end=\"758\">22 September 2026</strong>.</li>\n</ul>\n<h5 style=\"text-align: left\" data-section-id=\"o0mtqe\" data-start=\"555\" data-end=\"592\"><span style=\"color: #ff00ff\"><strong>Q7. How can I apply for HPPSC HPAS ?</strong></span></h5>\n<ul>\n<li style=\"text-align: left\" data-start=\"593\" data-end=\"655\">Candidates can apply online through the official recruitment link available on <strong data-start=\"1262\" data-end=\"1334\"><strong data-start=\"1262\" data-end=\"1334\"><strong data-start=\"1262\" data-end=\"1334\">SarkariResult.com (Since 2012) – Official Website of Sarkari Result®</strong></strong></strong></li>\n</ul>\n<figure id=\"attachment_30366\" aria-describedby=\"caption-attachment-30366\" style=\"width: 2550px\" class=\"wp-caption alignnone\"><img decoding=\"async\" class=\"size-full wp-image-30366\" title=\"HPPSC HPAS Online Form 2026 Sarkari Result\" src=\"https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-scaled.png\" alt=\"HPPSC HPAS Online Form 2026\" width=\"2560\" height=\"1467\" srcset=\"https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-scaled.png 2560w, https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-300x172.png 300w, https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-1024x587.png 1024w, https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-768x440.png 768w, https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-1536x880.png 1536w, https://www.sarkariresult.com/wp-content/uploads/2026/08/HPPSCe-2048x1173.png 2048w\" sizes=\"(max-width: 2560px) 100vw, 2560px\"><figcaption id=\"caption-attachment-30366\" class=\"wp-caption-text\">HPPSC HPAS Online Form 2026 Sarkari Result Official</figcaption></figure>\n</div>\n</div>\n</div>\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n\n<!-- Main Pajes 2 -->\n\n\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n",
