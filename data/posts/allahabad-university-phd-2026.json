  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information : </strong>&nbsp;</span><span style=\"font-size: inherit;\">has released a </span><span style=\"font-size: inherit;\">Notification for the</span> Allahabad University Ph.D Courses Admission 2026<span style=\"font-size: inherit;\">. Applications for the</span><span style=\"font-size: inherit;\"> Allahabad University Ph.D Online Form 2026 will Start From 02 September 2026, &amp; candidate can apply until 25 September 2026. Candidates must check the Complete details for Allahabad University Ph.D Online Form 2026 given below.</span></span></p>\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">University of Allahabad</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">Allahabad University Ph.D Online Form 2026</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>02 September 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <span style=\"color: #ff0000;\"><strong>25 September 2026</strong></span></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>25 September 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Exam Date :<b> Notify Soon</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card : <strong>Before Exam</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">General, EWS, OBC : <strong>Rs.</strong> <b>600/-&nbsp;</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">SC, ST, PH : <strong>Rs.</strong> <b>300/-&nbsp;</b></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Pay the Examination Fee Through Debit Card, Credit Card, Net Banking, E Challan, E Wallet, Cash Card Fee Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\">[adinserter block=”3″]</p>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Allahabad University Ph.D Online Form 2026 : Age Limit</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\"><strong>As Per Rule</strong></span></li>\n<li><span style=\"font-size: 12pt;\"><span style=\"color: #000000;\">Use <span style=\"background-color: #ffff00;\"> </span>Tool –</span> </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Allahabad University Ph.D Online Form 2026 : Course Details</strong></span></h3>\n<ul>\n<li style=\"text-align: justify;\"><span style=\"color: #000000; font-size: 12pt;\"><span style=\"color: #008000;\"><strong>Course Name&nbsp;</strong></span>: Ph.D Courses, </span></li>\n<li style=\"text-align: justify;\"><span style=\"color: #000000; font-size: 12pt;\"><strong><span style=\"color: #008000;\">Exam Conduct</span>&nbsp;</strong>: University of Allahabad</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Allahabad University Ph.D Online Form 2026 : Educational Qualification</b></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt; color: #000000;\">Candidates must have Master Degree in relevent Subject from the Any Recognized university in India.</span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">For Course Wise Eligibility Details, candidate must read the official notification carefully.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Allahabad University Ph.D Online Form 2026 : How To Apply</strong></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates can apply through link https://allduniv.ac.in/ or provided below in link section or they can also apply through official site of the Allahabad University before Last Date.</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">You Can Check other&nbsp;&nbsp;Notification Here –&nbsp;</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">For all the interested and eligible candidates who want to apply for Allahabad University Ph.D Online Form 2026 can read all the information related to the recruitment is given below and the link to apply is given in the Important Link section below.</span></li>\n<li><span style=\"color: #ff0000; font-size: 12pt;\"><strong>Note – छात्रो से ये अनुरोध किया जाता है की वो अपना फॉर्म भरने से पहले Official Notification (Last Date, Age Limit, Qualification) को ध्यान से जरूर पढे उसके बाद ही अपना फॉर्म भरे।</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>Allahabad University Ph.D Online Form 2026 : Mode of Selection</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\"><span style=\"color: #000000;\">Selection will be based on </span>Entrance Test.</span></li>\n</ul>\n<p style=\"text-align: center;\">[adinserter block=”3″]</p>\n</td>\n</tr>\