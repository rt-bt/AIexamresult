  "fullContentHtml": "\n<div class=\"ast-post-format- single-layout-1 ast-no-date-box\" style=\"height: auto !important;\">\n\n<p><!-- .entry-header --></p>\n<div class=\"entry-content clear\" style=\"height: auto !important;\">\n<div class=\"post-desc\">\n<p><span style=\"font-size: 13pt;\"><span style=\"color: #000000;\"><span style=\"color: #ff0000;\"><strong>Short Information :</strong>  <span style=\"color: #000000;\">has</span></span></span></span><span style=\"color: #000000;\"><span style=\"font-size: inherit;\"> released the </span><strong style=\"font-size: inherit;\" data-start=\"97\" data-end=\"126\">UP Home Guard PET Admit Card 2026</strong><span style=\"font-size: inherit;\"> on its official website.&nbsp;</span>This recruitment was released for <strong>41,424</strong> posts. The applications for <strong>UP Home Guard Recruitment 2025</strong> were accepted from <strong style=\"font-size: inherit;\" data-start=\"653\" data-end=\"693\">18 November 2025 to 17 December 2025</strong>. The PET / PST examination is going to Started from <strong style=\"font-size: inherit;\" data-start=\"228\" data-end=\"257\">14 September 2026</strong>. Candidates who appeared for this examination can download their <strong>UP Home Guard PET Admit Card 2026</strong>&nbsp;from the link given below.</span></p>\n</div>\n<div class=\"newtable1\">\n<table style=\"font-size: 16px; font-style: normal; width: 100%;\" width=\"100%\">\n<tbody>\n<tr>\n<td colspan=\"4\" width=\"100%\">\n<h2 style=\"text-align: center;\"><span style=\"color: #ff0000;\">Uttar Pradesh Police Recruitment and Promotion Board (UPPRPB)</span></h2>\n<h2 style=\"text-align: center;\"><span style=\"color: #008000;\">UP Home Guard PET Admit Card 2026</span></h2>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Important Dates</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Notification Date : <strong>18 November 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Application Start Date : <strong>18 November 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Last Date : <strong>17 December 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Fee Payment Last Date : <strong>17 December 2025</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">Correction Date : <strong>18-21 December 2025</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam Date : <strong>25, 26 &amp; 27 April 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Exam City Details : <strong>18 April 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Admit Card : <strong>22 April 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Answer Key : <strong>07 May 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Final Answer Key : <strong>28 June 2026</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Result : <strong>28 June 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">DV / PST Exam : <strong>13 July 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">DV / PST Admit Card : <strong>06 July 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">PET Exam Start : <strong>14 September 2026</strong></span></li>\n<li><span style=\"font-size: 12pt; color: #000000;\">PET Admit Card : <strong>07 September 2026</strong></span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>Application Fee</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">General, EWS, OBC : <strong>Rs. 400/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">SC, ST : <strong>Rs. 300/-</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates have to pay their Examination Fee Through Debit Card / Credit Card / Net Banking / UPI and Other Fee Payment Mode Only.</span></li>\n</ul>\n<p style=\"text-align: center;\">[adinserter block=”3″]</p>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>UP Police Home Guard Notification 2025 : Age Limit</strong></span></h3>\n<ul>\n<li><span style=\"font-size: 12pt;\"><strong><span style=\"color: #000000;\">Age Limit As On 01 July 2025</span></strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Minimum : <strong>18 Years</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Maximum : <strong>30 Years&nbsp;</strong></span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">Age Relaxation as per UP Police Home Guard Recruitment Rules.</span></li>\n<li><span style=\"font-size: 12pt;\">Use <span style=\"color: #0000ff; background-color: #ffff00;\"> </span>Tool – </span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 style=\"text-align: center;\"><span style=\"color: #000000;\"><strong>UP Home Guard 2025 : Vacancy Details</strong></span></h3>\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\"><strong>Total Posts : 41,424 Posts</strong></span></p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 46.1573%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>Category&nbsp;</strong></span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\"><strong>No. of Posts</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 46.1573%; text-align: center;\" rowspan=\"5\"><span style=\"font-size: 12pt; color: #000000;\">Home Guard</span></td>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">General&nbsp;</span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">16650</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">EWS</span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">4331</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">OBC</span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">11090</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">SC</span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">8645</span></td>\n</tr>\n<tr>\n<td style=\"width: 28.1491%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">ST</span></td>\n<td style=\"width: 25.6935%; text-align: center;\"><span style=\"font-size: 12pt; color: #000000;\">808</span></td>\n</tr>\n<tr>\n<td style=\"width: 46.1573%; text-align: center;\" colspan=\"3\"><span style=\"font-size: 12pt; color: #000000;\">Check District Wise &amp; Category Wise Vacancy Details – <span style=\"color: #ff0000;\"><a style=\"color: #ff0000;\" href=\"https://www.sarkariexam.com/wp-content/uploads/2025/11/Homeguard-Vigyapti-Annexure040580ca-3efd-4a45-b5c1-b90fee424333-1-3.pdf\" target=\"_blank\" rel=\"noopener\"><strong>Click Here</strong></a></span></span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>UP Police Home Guard Recruitment 2025 : Educational Qualification</b></span></h3>\n<ul>\n<li><span style=\"color: #000000; font-size: 12pt;\">Candidates who have passed their Class 10th (High School) Examination from Any Recognized Board in India will be eligible for this recruitment.</span></li>\n<li><span style=\"color: #000000; font-size: 12pt;\">All candidates must read the official information completely before applying.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>UP Police Home Guard</b></span><span style=\"color: #000000;\"><strong>&nbsp;</strong></span><span style=\"color: #000000;\"><b>Recruitment 2025 : Physical Standard Test</b></span></h3>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\" colspan=\"3\"><span style=\"color: #ff0000; font-size: 12pt;\"><strong>For Male Candidates</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Category</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Height</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Chest</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">UR / OBC / SC</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">168 CM</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">79-84 CM</span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">ST</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">160 CM</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">77-82 CM</span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\" colspan=\"3\"><span style=\"color: #ff0000; font-size: 12pt;\"><strong>For Female Candidates</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Category</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Height</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><b>Min. Weight</b></span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">UR / OBC / SC</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">152 CM</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">40 KG</span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">ST</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">147 CM</span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">40 KG</span></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n<tr>\n<td class=\"pd-0\" colspan=\"4\" width=\"100%\">\n<h3 align=\"center\"><span style=\"color: #000000;\"><b>UP Police Home Guard Recruitment 2025 : Physical Efficiency Test</b></span></h3>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><b>Category</b></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Race Distance</strong></span></td>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\"><strong>Time Duration</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 33.3333%; text-align: center;\"><span style=\"font-size: 12pt;\">Male</span></